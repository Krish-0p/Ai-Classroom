DATABASE_URL=postgresql://openlearn:openlearn_local@localhost:5432/openlearn
BETTER_AUTH_URL=http://localhost:3000
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Required for password-reset email delivery (create an API key at resend.com).
RESEND_API_KEY=
RESEND_FROM_EMAIL=OpenLearn Lab <noreply@example.com>
# Optional destructive-test database; must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://openlearn:openlearn_local@localhost:5432/openlearn_test
# AI extraction. Keep model IDs configurable; manual editing needs no API key.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
AI_PRIMARY_PROVIDER=gemini
AI_FAST_PROVIDER=groq
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
SOURCE_STORAGE_DIR=.data/sources
# Maximum cosine distance for tutor evidence (0..1; lower is stricter).
TUTOR_MAX_COSINE_DISTANCE=0.55

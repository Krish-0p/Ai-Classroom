DATABASE_URL=postgresql://openlearn:openlearn_local@localhost:5432/openlearn
# Optional direct Neon URL for Prisma migrations; runtime uses pooled DATABASE_URL.
DIRECT_URL=
BETTER_AUTH_URL=http://localhost:3000
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Required for password-reset email delivery (create an API key at resend.com).
RESEND_API_KEY=
RESEND_FROM_EMAIL=OpenLearn Lab <noreply@example.com>
# Optional destructive-test database; must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://openlearn:openlearn_local@localhost:5432/openlearn_test
# AI extraction. Keep model IDs configurable; manual editing needs no API key.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
AI_PRIMARY_PROVIDER=gemini
AI_FAST_PROVIDER=groq
# Set false to use only the selected provider for each text task.
AI_PROVIDER_FALLBACK_ENABLED=true
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
# Keep completions bounded on token-limited plans. Increase for larger drafts.
GROQ_MAX_COMPLETION_TOKENS=4096
# GPT-OSS supports low, medium, or high; ignored for other model families.
GROQ_REASONING_EFFORT=low
# json_schema uses strict structured output; use json_object for other models.
GROQ_STRUCTURED_OUTPUT_MODE=json_schema
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
SOURCE_STORAGE_DIR=.data/sources
# local for development; set database on Vercel (also selected automatically there).
SOURCE_STORAGE_PROVIDER=local
# Embedding/TTS/transcription settings are reserved optional capabilities.
# Curriculum slides use the fast text provider and require no embeddings.
